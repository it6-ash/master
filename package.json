{
  "name": "kw-estate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Living dashboard for KW Group infrastructure. Paste raw dumps into raw/, get a rebuilt single-file dashboard in dist/.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "ingest": "node src/ingest/index.js",
    "build": "node src/build.js",
    "serve": "node src/serve.js",
    "watch": "node src/watch.js",
    "diff": "node src/diff.js",
    "validate": "node src/validate.js",
    "new-project": "node src/new-project.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e",
    "check": "node src/check.js",
    "sync": "node --env-file-if-exists=.env src/sync.js",
    "deploy": "node src/deploy.js",
    "admin": "node --env-file-if-exists=.env src/admin.js",
    "wf-add": "node --env-file-if-exists=.env src/n8n/registry.js",
    "wf-sync": "node --env-file-if-exists=.env src/n8n/collect.js",
    "wf-fields": "node --env-file-if-exists=.env src/n8n/fields.js",
    "wf-report": "node --env-file-if-exists=.env src/n8n/report.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
