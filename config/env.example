# Copy to .env in the repo root to run Estate locally:
#
#   cp config/env.example .env
#
# .env is git-ignored. `npm run admin`, `wf-sync`, `wf-report` and `sync` load
# it through node's own --env-file-if-exists, so there is nothing to install
# and nothing happens if the file is absent.
#
# ON srv1340120 THIS FILE IS NOT USED. There the same variables live in
# /etc/kw-estate.env, mode 0600, created by deploy/install.sh and read by the
# systemd units. Two locations because a secret belonging to a machine should
# be owned by that machine, not carried in a checkout that gets cloned.

# --- sign-in -----------------------------------------------------------------
# An OAuth 2.0 Web application client from the Google Cloud console:
#   APIs & Services -> Credentials -> Create credentials -> OAuth client ID
#
# Authorized JavaScript origins:  leave EMPTY. This is the server-side
#   authorization-code flow; no browser JavaScript ever calls Google.
#
# Authorized redirect URIs: must match ADMIN_BASE_URL + /auth/callback exactly
#   — scheme, host, port, path, no trailing slash. For the defaults below:
#       http://localhost:4179/auth/callback
#   and on the box:
#       https://estate.leadq.co.in/auth/callback
#
#   NOTE: localhost and 127.0.0.1 are DIFFERENT redirect URIs to Google. If you
#   register localhost, browse to localhost — the IP will be rejected with
#   redirect_uri_mismatch, which does not say which half is wrong.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where this instance is reached. The redirect URI is built from it, and it is
# also how the server decides whether to set `Secure` on the session cookie —
# Secure over plain http means the browser silently drops the cookie and you
# get an endless redirect to /login with nothing in any log saying why.
ADMIN_BASE_URL=http://localhost:4179

# Signs the session cookie and the OAuth state. Any long random string; a weak
# one is a forgeable session. Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# --- n8n ---------------------------------------------------------------------
# One per instance declared in config/n8n.example.json, named by its apiKeyEnv.
# Create each in n8n: Settings -> n8n API -> Create an API key.
# Without these the collector reports that it cannot reach n8n and writes
# nothing, which is the correct behaviour on a laptop.
N8N_API_KEY_MAIN=
# N8N_API_KEY_VFA2=

# Optional. Defaults to 4179 / 127.0.0.1.
# ADMIN_PORT=4179
# ADMIN_HOST=127.0.0.1
